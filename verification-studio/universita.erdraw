      "data_type": "VARCHAR(255)",
      "is_pk": false,
      "nullable": true,
      "unique": false,
      "derived": false,
      "notes": "",
      "isa_total": false,
      "isa_disjoint": true,
      "text_html": "<p style=\"color:#087f73;font-weight:700;white-space:pre-wrap\">Archivio persone</p><p style=\"white-space:pre-wrap\">Gerarchia <b>totale sovrapposta</b>: una persona può essere lavoratore e studente.</p><p style=\"white-space:pre-wrap\"><i>Recapiti</i> è un aggregato di tipo e valore.</p>",
