    {
      "kind": "text",
      "name": "Archivio persone\nGerarchia totale sovrapposta: una persona può essere lavoratore e studente.\nRecapiti è un aggregato di tipo e valore.",
      "x": 70,
      "y": 580,
      "width": 650,
      "height": 120,
      "id": "f4200f4350f5439597835aae82589d3d",
